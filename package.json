{
  "name": "bunraku",
  "version": "0.1.41",
  "private": true,
  "type": "module",
  "description": "The forge for AI-roleplay content. Convert, edit, and ship any format.",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "bunraku": "./src/cli.ts",
    "kit": "./src/kit/index.tsx"
  },
  "scripts": {
    "bunraku": "bun run src/cli.ts",
    "kit": "bun run src/kit/index.tsx",
    "dev": "bun run src/cli.ts ui 8321",
    "test": "bun test ./src ./scripts --timeout 120000",
    "test:m0": "bun test src/m0.smoke.test.ts src/formats/sillytavern/sillytavern.test.ts src/core --timeout 60000",
    "test:m1": "bun test src/m1.convert.smoke.test.ts src/convert.test.ts --timeout 60000",
    "test:node-core": "bun run scripts/node-core-smoke.ts",
    "probe:sqlite": "bun run scripts/probe-sqlite-runtime.ts",
    "perf:check": "bun run scripts/perf-gate.ts && bun run scripts/perf-gate-summaries.ts && bun run scripts/perf-gate-health.ts && bun run scripts/perf-gate-stats.ts",
    "perf-browser": "bun run scripts/perf-browser.ts",
    "scale:fast": "bun run scripts/scale/fast-gate.ts && bun run scripts/scale/patch-fast-gate.ts && bun test scripts/scale/fixtures.test.ts src/stage/store/content-store-patch.sqlite.test.ts src/stage/caches.test.ts src/ui/_shared/caches.test.ts src/ui/_shared/art-cache.test.ts src/ui/_shared/use-visible-interval.test.tsx src/ui/apps/library/shelves.test.tsx src/ui/apps/workbench/preset/block-list.test.tsx src/ui/apps/workbench/preset/block-row-render-count.test.tsx src/ui/apps/library/card-row-render-count.test.tsx",
    "scale:timed": "bun run scripts/scale/timed.ts",
    "scale:release-evidence": "bun run scripts/scale/release-evidence.ts",
    "scale:patch": "bun run scripts/scale/patch-gate.ts",
    "typecheck": "bunx tsc --noEmit",
    "ic": "bun run scripts/ic-glyphs.ts",
    "ic:check": "bun run scripts/ic-glyphs.ts --check",
    "matrix": "bun run scripts/format-matrix.ts",
    "matrix:check": "bun run scripts/format-matrix.ts --check",
    "docs:fields": "bun run scripts/docs-fields.ts",
    "docs:fields:check": "bun run scripts/docs-fields.ts --check",
    "docs:parts": "bun run scripts/docs-parts.ts",
    "docs:parts:check": "bun run scripts/docs-parts.ts --check",
    "docs:index": "bun run scripts/docs-index.ts",
    "docs:index:check": "bun run scripts/docs-index.ts --check",
    "docs:summaries:inventory": "bun run scripts/docs-summaries.ts inventory",
    "docs:summaries:scaffold": "bun run scripts/docs-summaries.ts scaffold",
    "docs:summaries:stamp": "bun run scripts/docs-summaries.ts stamp",
    "docs:summaries:check": "bun run scripts/docs-summaries.ts check",
    "docs:summaries:queue": "bun run scripts/docs-summaries.ts queue",
    "docs:summaries:review": "bun run scripts/docs-summaries.ts review",
    "docs:figures": "bun run scripts/docs-figures.ts",
    "docs:figures:check": "bun run scripts/docs-figures.ts --check",
    "capabilities": "bun run scripts/capability-manifest.ts",
    "capabilities:check": "bun run scripts/capability-manifest.ts --check",
    "license:audit": "bun run scripts/license-audit.ts",
    "build:cli": "bun build --compile --external @anthropic-ai/claude-agent-sdk --root src src/cli.ts src/stage/store/sqlite/maintenance-worker.ts src/stage/crypto/password-worker.ts src/stage/store/cold-read-worker.ts src/stage/search/search-worker.ts --outfile dist/bunraku",
    "build:pages": "bun run scripts/build-pages.ts",
    "preview:pages": "bun run scripts/preview-pages.ts",
    "scan:colors": "bun run scripts/hooks/no-hardcode-colors.ts --scan",
    "scan:colors:check": "bun run scripts/hooks/no-hardcode-colors.ts --check",
    "scan:style": "bun run scripts/hooks/style-guard.ts --scan",
    "scan:clones": "bun run scripts/hooks/clones.ts --scan",
    "clones:baseline": "bun run scripts/hooks/clones.ts --baseline",
    "scan:lines": "bun run scripts/hooks/file-lines.ts --scan",
    "scan:emdash": "bun run scripts/hooks/prose-guards.ts --emdash",
    "scan:links": "bun run scripts/hooks/prose-guards.ts --links",
    "scan:headers": "bun run scripts/hooks/doctrines.ts --headers",
    "apps:documented": "bun run scripts/hooks/apps-documented.ts",
    "scan:emoji": "bun run scripts/hooks/doctrines.ts --emoji",
    "format:no-emoji": "bun run scripts/hooks/remove-emoji.ts",
    "macros:pins": "bun run scripts/update-macro-pins.ts",
    "macros:oracle": "bun run scripts/macro-oracle/extract.ts",
    "lint:ui": "bunx eslint \"src/ui/**/*.{ts,tsx}\" \"src/kit/**/*.{ts,tsx}\" --max-warnings 0",
    "catalog": "bun run scripts/hooks/component-catalog.ts",
    "catalog:check": "bun run scripts/hooks/component-catalog.ts --check",
    "codemap": "bun run scripts/code-map.ts",
    "codemap:check": "bun run scripts/code-map.ts --check",
    "publish:export": "bun run scripts/publish-export.ts",
    "notices": "bun run scripts/third-party-notices.ts",
    "notices:check": "bun run scripts/third-party-notices.ts --check",
    "helpers": "bun run scripts/helpers.ts",
    "helpers:check": "bun run scripts/helpers.ts --check",
    "glossary:check": "bun run scripts/hooks/glossary.ts",
    "mutation:check": "bun run scripts/mutation-check.ts",
    "theme:measure": "bun run scripts/theme-measure.ts",
    "verify:ci": "bun run typecheck && bun run probe:sqlite && bun run perf:check && bun run scale:fast && bun run test:node-core && bun run license:audit && bun run test && bun run scan:lines && bun run scan:colors:check && bun run scan:emdash && bun run scan:emoji && bun run scan:headers && bun run scan:links && bun run scan:boundaries && bun run scan:virtualizers && bun run scan:theme-keys && bun run scan:parts && bun run lint:ui && bun run apps:documented && bun run catalog:check && bun run codemap:check && bun run helpers:check && bun run glossary:check && bun run matrix:check && bun run docs:fields:check && bun run docs:parts:check && bun run docs:index:check && bun run docs:summaries:check && bun run docs:figures:check && bun run capabilities:check && bun run kit:manifest:check",
    "gate": "bun run scripts/hooks/gate.ts --worktree",
    "audit": "bun scripts/audit/run.ts all",
    "audit:rooms": "bun scripts/audit/run.ts rooms",
    "audit:library": "bun scripts/audit/run.ts library",
    "audit:editors": "bun scripts/audit/run.ts editors",
    "audit:setup": "bun scripts/audit/run.ts setup",
    "audit:promises": "bun scripts/audit/run.ts promises",
    "audit:clicks": "bun scripts/audit/run.ts clicks",
    "audit:legibility:dark": "bun scripts/audit/run.ts legibility dark",
    "audit:legibility:light": "bun scripts/audit/run.ts legibility light",
    "audit:watch": "bun scripts/audit/run.ts watch",
    "kit:manifest": "bun run scripts/kit-manifest.ts",
    "kit:manifest:check": "bun run scripts/kit-manifest.ts --check",
    "scan:boundaries": "bun run scripts/hooks/stage-boundary.ts",
    "scan:virtualizers": "bun run scripts/hooks/virtualizer-boundary.ts",
    "scan:theme-keys": "bun run scripts/hooks/theme-keys.ts",
    "scan:parts": "bun run scripts/hooks/part-names.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.102",
    "@iconify-json/mdi": "1.2.3",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "typescript-eslint": "^8.62.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.221"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/google": "^4.0.22",
    "@ai-sdk/groq": "^4.0.13",
    "@ai-sdk/mistral": "^4.0.14",
    "@ai-sdk/openai": "^4.0.18",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@noble/hashes": "^2.4.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentui/core": "0.5.1",
    "@opentui/keymap": "0.5.1",
    "@opentui/react": "0.5.1",
    "@scure/bip39": "^2.4.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "ai": "^7.0.35",
    "dompurify": "^3.4.15",
    "emoji-picker-react": "4.16.1",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^4.0.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.5",
    "ogl": "1.0.11",
    "png-chunk-text": "^1.0.0",
    "png-chunks-encode": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wasmoon": "1.16.0",
    "webview-bun": "^2.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "qs": "^6.16.0",
    "undici": "^7.29.0",
    "fast-uri": "^3.1.6",
    "brace-expansion": "^5.0.8",
    "baseline-browser-mapping": "^2.11.0",
    "hono": "^4.13.5",
    "browserslist": "^4.29.0"
  }
}
