    "palette": {
      "surface": {
        "well": "#03060f",
        "base": "#070b18",
        "sunken": "#0b1124",
        "field": "#060a15",
        "panel": "#111a33",
        "raised": "#1a2547",
        "ink": "#02040a"
      },
      "line": {
        "strong": "#7d9cf0",
        "line": "#28365e",
        "track": "#232f55",
        "control": "#8aa4e6",
        "focus": "#ffd23f"
      },
      "text": {
        "text": "#f4f7ff",
        "soft": "#d9e2fb",
        "dim": "#b9c6e8",
        "faint": "#9aa9d0",
        "onTint": "#06091a",
        "onDeep": "#ffffff"
