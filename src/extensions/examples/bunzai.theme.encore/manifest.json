      "roles": {
        "brand": {
          "fill": "#ff7a45",
          "text": "#ff9a6b",
          "deep": "#a8420f"
        },
        "action": {
          "fill": "#5c9dff",
          "text": "#82b4ff",
          "deep": "#2758a6"
        },
        "select": {
          "fill": "#b48cff",
          "text": "#c4a3ff",
          "deep": "#6a4ca6"
        },
        "ok": {
          "fill": "#3ee08f",
          "text": "#3ee08f",
          "deep": "#036b39"
        },
        "warn": {
          "fill": "#ffb83d",
          "text": "#ffb83d",
          "deep": "#7c4d00"
        },
        "danger": {
          "fill": "#ff5a67",
          "text": "#ff7a85",
          "deep": "#a62530"
        },
        "info": {
          "fill": "#2fd9cf",
          "text": "#2fd9cf",
          "deep": "#006963"
        }
      }
    },
    "type": {
      "display": "archivo",
      "ui": "archivo",
      "body": "archivo",
      "mono": "plex-mono",
      "scale": 0
    },
    "shape": {
      "frame": "bracket",
      "frameWidth": 2,
      "density": "dense",
      "motion": "snappy",
      "chrome": "bunzai"
    },
    "accent": {
      "follows": "user"
    },
    "marks": {
      "dock": "ticket-bun",
      "bookFrame": "ticket-frame"
    }
  },
  "assets": [
    {
      "id": "ticket-bun",
      "path": "assets/ticket-bun.svg",
      "mediaType": "image/svg+xml"
    },
    {
      "id": "ticket-frame",
      "path": "assets/ticket-frame.svg",
      "mediaType": "image/svg+xml"
    },
    {
      "id": "crest",
      "path": "assets/crest.png",
      "mediaType": "image/png"
    },
    {
      "id": "starfield",
      "path": "assets/starfield.png",
      "mediaType": "image/png"
    }
  ],
  "fonts": [
    {
      "id": "silkscreen",
      "path": "fonts/silkscreen-700.woff2",
      "mediaType": "font/woff2"
    }
  ],
  "styles": "styles.css",
  "slots": {
    "library.header": [
      {
        "kind": "image",
        "asset": "crest",
        "alt": "Encore crest, a pixel bunny on a shield"
      },
      {
        "kind": "text",
        "text": "Player one ready",
        "class": "mod-banner"
      }
    ],
    "scenes.header": [
      {
        "kind": "text",
        "text": "Stage select",
        "class": "mod-tip"
      }
    ],
    "scene.backdrop": [
      {
        "kind": "image",
        "asset": "crest",
        "alt": ""
      }
    ],
    "shell.status.end": [
      {
        "kind": "text",
        "text": "Encore",
        "class": "mod-tip"
      }
    ]
  }
}
