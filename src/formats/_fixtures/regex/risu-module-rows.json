{
  "_source": "Synthetic Risu customscript rows authored for codec tests. Constructed patterns preserve editrequest/editprocess/editdisplay, malformed disabled, flags, and cbs macro coverage. See SOURCES.md.",
  "rows": [
    {
      "comment": "Remove request marker",
      "in": "<request-tag>",
      "flag": "",
      "out": "",
      "type": "editrequest",
      "ableFlag": true
    },
    {
      "comment": "Remove display marker",
      "in": "<display-marker>[^<]*",
      "out": "",
